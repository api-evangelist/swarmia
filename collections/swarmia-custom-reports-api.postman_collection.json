      "name": "Custom reports",
      "description": {
        "content": "Saved custom reports created in the Swarmia explore view.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "14ea55df-18dd-4b5b-9117-1c94f05670c1",
          "name": "Run a saved custom report",
          "request": {
            "name": "Run a saved custom report",
            "description": {
              "content": "Executes a saved custom report (created at app.swarmia.com/explore) by its UUID. Supports pagination, dynamic columns, and timeframe overrides.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "custom",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timeframe",
                  "value": "<string>",
                  "description": "Relative timeframe (e.g. last7days). Defaults to the last 7 days (UTC)."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "Start date in YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "End date in YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor returned by a previous response."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) UUID of the saved custom report."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
